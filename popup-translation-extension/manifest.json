{
  "manifest_version": 3,
  "name": "Popup Translation - AI 划词翻译与生词高亮 (含 Reddit & 路透社一键翻译)",
  "version": "4.8.1",
  "description": "全网页 AI 划词翻译、动森 UI 字典弹窗、Notion 生词库增量同步与页面生词高亮。专属适配 Reddit 与路透社 (Reuters) 一键双语全文翻译。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png",
    "default_title": "Popup Translation 划词翻译与站点增强"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*"
  ]
}

